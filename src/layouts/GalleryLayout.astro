---
import '../styles/gallery.css';
interface Props { title?: string }
const { title = 'Kiln — your ideas, fired up.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171715" />
    <meta name="description" content="A local workshop for interactive artifacts. Make something, keep every revision, and share it with the world." />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
